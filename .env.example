# Development secrets for docker-compose.yml. Copy to .env and fill in.
POSTGRES_USER=fmc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=freemathcamp
WEB_ORIGIN=http://localhost:3000
# Optional: enables "Continue with Google". Create an OAuth client (Web application) at
# https://console.cloud.google.com/apis/credentials with redirect URI
#   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign-in from the iOS app. Google: the iOS OAuth client id (Google Cloud → Credentials →
# iOS, bundle id com.freemathcamp.app); empty hides Google in the app. Apple: the app's bundle id.
GOOGLE_IOS_CLIENT_ID=
APPLE_BUNDLE_ID=com.freemathcamp.app
# Web Push (VAPID) keys. Generated by `pnpm setup`, or add them with
#   node scripts/vapid-keys.mjs <this file>
# Without them, notifications stay in the app (no browser push).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Production secrets for docker-compose.prod.yml. Copy to .env.production and fill in.
POSTGRES_USER=fmc
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=freemathcamp
# Public origin of the web app (cookies and CSRF checks are bound to it).
WEB_ORIGIN=https://freemathcamp.app
API_PORT=4100
SESSION_TTL_DAYS=30
# Redirect URI to register with Google: ${WEB_ORIGIN}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign-in from the iOS app. Google uses GOOGLE_CLIENT_ID above: the app names the web client
# as its server client, so its ID tokens are issued to it. GOOGLE_IOS_CLIENT_ID (the iOS client
# id) is optional, for builds that don't. Apple: the app's bundle id.
GOOGLE_IOS_CLIENT_ID=
APPLE_BUNDLE_ID=com.freemathcamp.app
# A key with Sign in with Apple enabled (Apple Developer → Keys), so deleting an account
# revokes its Apple tokens, as Apple requires. The APNs key below can be the same key if it
# has both capabilities. APPLE_PRIVATE_KEY is the .p8 contents with newlines written as \n.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Shared with the Vercel project (PROXY_SECRET) so the API can trust forwarded client IPs.
PROXY_SECRET=change-me-to-a-long-random-string
# Transactional email (verification links). Without a key, emails are only logged.
RESEND_API_KEY=
EMAIL_FROM=FreeMathCamp <noreply@freemathcamp.app>
EMAIL_REPLY_TO=FreeMathCamp <hello@freemathcamp.app>
# Web Push (VAPID) keys. Generated by `pnpm setup`, or add them with
#   node scripts/vapid-keys.mjs <this file>
# Without them, notifications stay in the app (no browser push).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URL or mailto: for push services.
VAPID_SUBJECT=https://freemathcamp.app
# iOS app push via APNs token auth (Apple Developer → Keys → a key with APNs enabled).
# APNS_PRIVATE_KEY is the .p8 file's contents with newlines written as \n.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.freemathcamp.app
APNS_PRIVATE_KEY=
APNS_PRODUCTION=true

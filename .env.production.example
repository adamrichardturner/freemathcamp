# Production secrets for docker-compose.prod.yml. Copy to .env.production and fill in.
POSTGRES_USER=fmc
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=freemathcamp
# Public origin of the web app (cookies and CSRF checks are bound to it).
WEB_ORIGIN=https://freemathcamp.example
API_PORT=4100
SESSION_TTL_DAYS=30
# Redirect URI to register with Google: ${WEB_ORIGIN}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

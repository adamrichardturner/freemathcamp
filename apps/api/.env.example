NODE_ENV=development
PORT=4100
DATABASE_URL=postgres://fmc:change-me@127.0.0.1:5433/freemathcamp
# Origin of the web app; state-changing requests from other origins are rejected.
WEB_ORIGIN=http://localhost:3000
SESSION_TTL_DAYS=30
# Web Push (VAPID) keys. Generated by `pnpm setup`, or add them with
#   node scripts/vapid-keys.mjs <this file>
# Without them, notifications stay in the app (no browser push).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Copy to .env (git-ignored). Expo loads it for `expo start`, `expo run:ios` and local EAS builds.

# Where the app's API lives. The simulator reaches your Mac at localhost; on a
# physical iPhone use your Mac's LAN address, or the production API.
EXPO_PUBLIC_API_URL=http://localhost:4100
EXPO_PUBLIC_WEB_URL=https://freemathcamp.app

# Google sign-in. The iOS OAuth client from Google Cloud Console (type iOS, bundle id
# com.freemathcamp.app), in the same project as the web client; leave empty to hide the Google button.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# The web OAuth client id, the same value as the API's GOOGLE_CLIENT_ID (it's public, not a secret).
# Google then issues ID tokens to it, so the API needs no extra setting.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Your Apple Developer Team ID (Membership details), used for code signing.
APPLE_TEAM_ID=

# Push entitlement: "development" for builds run from Xcode, otherwise production.
APS_ENVIRONMENT=development

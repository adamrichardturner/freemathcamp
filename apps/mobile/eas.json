{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APS_ENVIRONMENT": "development",
        "EXPO_PUBLIC_API_URL": "https://api.freemathcamp.app",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "112241041582-qgck0fbhs027ji62eag3g9f47k5ogdu7.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "112241041582-cdhrtfr936j1mq09vmnj1dl2404mckhq.apps.googleusercontent.com"
      }
    },
    "simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.freemathcamp.app",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "112241041582-qgck0fbhs027ji62eag3g9f47k5ogdu7.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "112241041582-cdhrtfr936j1mq09vmnj1dl2404mckhq.apps.googleusercontent.com"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.freemathcamp.app",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "112241041582-qgck0fbhs027ji62eag3g9f47k5ogdu7.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "112241041582-cdhrtfr936j1mq09vmnj1dl2404mckhq.apps.googleusercontent.com"
      },
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6829382170"
      }
    }
  }
}

  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "ios:release": "expo run:ios --configuration Release",
    "prebuild": "expo prebuild --platform ios --clean",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "build:ios:sim": "npx eas-cli@latest build --platform ios --profile simulator --local --output build/FreeMathCamp-sim.tar.gz",
    "build:ios:dev": "npx eas-cli@latest build --platform ios --profile development --local --output build/FreeMathCamp-dev.ipa",
    "build:ios:preview": "npx eas-cli@latest build --platform ios --profile preview --local --output build/FreeMathCamp-preview.ipa",
    "build:ios": "npx eas-cli@latest build --platform ios --profile production --local --output build/FreeMathCamp.ipa",
    "build:ios:cloud": "npx eas-cli@latest build --platform ios --profile production",
    "submit:ios": "npx eas-cli@latest submit --platform ios --profile production --path build/FreeMathCamp.ipa",
    "release:ios": "pnpm build:ios && pnpm submit:ios",
    "archive:ios": "bash scripts/archive-ios.sh",
    "katex-css": "node scripts/katex-css.mjs",
    "store:push": "npx eas-cli@latest metadata:push --profile production"
  },
  "private": true

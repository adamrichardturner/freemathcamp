{
  "name": "freemathcamp",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "setup": "node scripts/setup.mjs && pnpm db:up && pnpm db:migrate",
    "dev": "pnpm --parallel --filter @fmc/api --filter @fmc/web dev",
    "dev:full": "pnpm db:up && pnpm db:migrate && pnpm dev",
    "dev:api": "pnpm --filter @fmc/api dev",
    "dev:web": "pnpm --filter @fmc/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --parallel --filter @fmc/api --filter @fmc/web start",
    "start:api": "pnpm --filter @fmc/api start",
    "start:web": "pnpm --filter @fmc/web start",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @fmc/web lint",
    "test": "pnpm -r test",
    "test:engine": "pnpm --filter @fmc/api exec vitest run test/engine.test.ts",
    "test:curriculum": "pnpm --filter @fmc/curriculum test",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose stop db",
    "db:migrate": "pnpm --filter @fmc/api migrate",
    "db:rollback": "pnpm --filter @fmc/api migrate:down",
    "db:psql": "docker compose exec db sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'",
    "db:reset": "docker compose down -v && pnpm db:up && pnpm db:migrate",
    "docker:dev": "docker compose --profile api up --build",
    "docker:down": "docker compose --profile api down",
    "docker:prod": "docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml --env-file .env.production logs -f api",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml --env-file .env.production down",
    "clean": "rm -rf apps/web/.next apps/api/dist"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
